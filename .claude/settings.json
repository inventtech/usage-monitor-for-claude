{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-4-6[1m]",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git merge-base:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git status:*)",
      "Bash(gh api:*)",
      "Bash(gh issue:*)",
      "Bash(gh label:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr view:*)",
      "Bash(bun install:*)",
      "Bash(bun run build:*)",
      "Bash(bun run db:gen:*)",
      "Bash(bun run db:migrate:*)",
      "Bash(bun run db:up:*)",
      "Bash(bun run db:down:*)",
      "Bash(bun run dev:*)",
      "Bash(bun run lint:*)",
      "Bash(bun run test:*)",
      "Bash(bun run tools/*)",
      "Bash(bun run typecheck:*)",
      "Bash(bunx biome:*)",
      "Bash(bunx kill-port:*)",
      "Bash(bunx prisma:*)",
      "Bash(bunx tsc:*)",
      "Bash(bunx vitest:*)",
      "Bash(docker ps:*)",
      "Bash(docker compose:*)",
      "Bash(apt-get download:*)",
      "Bash(dpkg-deb:*)",
      "Bash(curl:*)",
      "Bash(jq:*)",
      "Bash(pkill:*)"
    ],
    "deny": [
      "Read(./cert/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./tools/config.ts)",
      "Read(./tools/.token)",
      "Read(./**/.env*)",
      "Edit(./cert/**)",
      "Edit(./**/.env*)",
      "Write(./cert/**)",
      "Write(./**/.env*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "enableAllProjectMcpServers": true,
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false,
    "claude-hud@claude-hud": true
  },
  "language": "thai",
  "spinnerTipsEnabled": false,
  "plansDirectory": ".claude/plans"
}
